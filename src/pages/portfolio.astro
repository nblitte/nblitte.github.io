---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<BaseLayout pageTitle="Portfolio" pageDescription="Projets de cybersécurité, qualité logicielle et automatisation des tests.">
  <h1>Portfolio</h1>
  <p class="muted">Projets documentés : détection, inventaire, analyse de risques, automatisation, recommandations.</p>

  <div class="grid" style="grid-template-columns: repeat(2, minmax(0,1fr));">
    {projects.map((p) => (
      <ProjectCard
        title={p.data.title}
        description={p.data.subtitle ?? ""}
        stack={p.data.tags}
        href={`/projects/${p.id}`}
        github={p.data.github}
      />
    ))}
  </div>

  <section class="section">
    <h2>Roadmap — prochains projets</h2>
    <p class="muted">Repos identifiés, en attente de mise en œuvre.</p>

    <div class="grid">
      <article class="card">
        <h3>security-auth-controls-automation</h3>
        <p class="muted">Validation automatisée des contrôles d'authentification (web + API) : accès non authentifié, session, MFA, token expiré. Pipeline CI dédié.</p>
        <div class="tags"><span class="pill">Selenium</span><span class="pill">Postman/Newman</span><span class="pill">Jenkins</span></div>
      </article>

      <article class="card">
        <h3>risk-register-mini-iso27001</h3>
        <p class="muted">Registre de risques et mesures de traitement, structuré selon une logique GRC (ISO 27001 / NIST).</p>
        <div class="tags"><span class="pill">GRC</span><span class="pill">ISO 27001</span></div>
      </article>

      <article class="card">
        <h3>log-analysis-lab</h3>
        <p class="muted">Parsing de logs, détection simple d'anomalies, production de rapport — orienté SOC / Blue Team.</p>
        <div class="tags"><span class="pill">SOC</span><span class="pill">Logs</span></div>
      </article>

      <article class="card">
        <h3>policies-starter-pack</h3>
        <p class="muted">Modèles de politiques de sécurité (PSSI, charte utilisateur, gestion des mots de passe) réutilisables.</p>
        <div class="tags"><span class="pill">GRC</span><span class="pill">Politiques</span></div>
      </article>
    </div>
  </section>
</BaseLayout>
